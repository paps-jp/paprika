# venv / Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# paprika runtime artifacts — ignore data/ except the plugin registry.
# Pattern: ignore everything under data/ with data/*; then un-ignore
# the plugin catalog AND the plugin adapters so git tracks both:
#   data/tools/catalog.json     ← directory of known plugins (operator-edited)
#   data/tools/installed/<n>/   ← bundled plugin sources
# Worker .lib / venv dirs INSIDE an installed plugin are still ignored.
# Runtime audit log (invocations.jsonl) is excluded too -- regenerated.
data/*
!data/tools/
data/tools/*
!data/tools/catalog.json
!data/tools/installed/
data/tools/installed/*
!data/tools/installed/*/
data/tools/installed/*/venv/
data/tools/installed/*/lib/
data/tools/installed/*/__pycache__/
data/tools/invocations.jsonl
# Pipeline-coupled plugins kept OUT of this (public) repo -- they depend on the
# downstream pipeline's DB schema. Versioned in the private companion repo
# paps-jp/paprika-internal (internal/plugins/) and shipped to hubs out-of-band.
data/tools/installed/video-gc/
assets/
downloaded-paps/
downloaded/

# CLI scratch files
page.html
iframe.html
log.txt
*.log

# Local environment overrides
.env
.env.local
.env.agent
*.local
scripts/workers.env
scripts/extra-hosts.env
scripts/llm.env

# Local-only ops notes (contains internal IPs / SSH key paths). The file itself
# is version-controlled in the private companion repo paps-jp/paprika-internal
# (internal/CLAUDE.md is a hardlink to this one).
CLAUDE.md
.claude/

# paprika_client example-script run artifacts
client/python/*.png
client/python/*.jpg
client/python/build/
client/python/dist/
client/python/*.egg-info/

# Docker
*.tar.gz
*.tar

# Windows build artefacts (PyInstaller --onedir output + bundled binaries
# fetched by windows/build.ps1; never checked in -- regenerated each build)
build/
dist/
windows/bin/redis/
windows/bin/vnc/
*.spec.bak

# Private companion repo, nested here as its own git repo:
#   internal/ = paps-jp/paprika-internal (private)
# Holds design notes, real-infrastructure ops scripts and operator docs that
# must never land in this public repo. See internal/README.md for the
# public/private decision rule.
internal/

# Private keys (CRX signing keys, TLS keys, SSH keys, …). The CRX
# signing key for the Paprika Agent extension used to live at
# server/web/extensions/paprika-agent.pem — keep it OUT of git from
# now on (operator stores it in a secrets vault and supplies it only
# when re-packing a new CRX).
*.pem
*.key
*.p12
*.pfx

# Scratch / one-off / temp dumps. These accumulate in the repo root
# during exploratory work; never check them in.
tmp_*.json
tmp_*.txt
*.orig
*.rej
patch_*.py
extracted-from-*
orig.png
orig.jpg
*.scratch
# Operator scratch dir: ad-hoc probe / cmp / deploy / test one-offs.
_vfix/
