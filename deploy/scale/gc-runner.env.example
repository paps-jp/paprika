# Per-host settings for deploy/scale/docker-compose.gc-runner.yml.
# Copy to /opt/paprika/gc-runner.env on each shard host; GC_SHARD differs
# per host, everything else is identical fleet-wide.
GC_SHARDS=3
GC_SHARD=0
# rows per pass; ~40 s at 48-way, keeps SIGTERM responsive
GC_PASS_CAP=5000
GC_DELETE_CONCURRENCY=48
GC_IDLE_S=30
# crash safety net on the Redis lock. Refreshed every pass (~40 s); if every
# runner dies hard the in-hub fallback loops wait this long before resuming.
GC_LOCK_TTL_S=600
# the hub.env values below are for the hub's own loop; the runner sizes its
# S3 pool from these too, so keep them >= GC_DELETE_CONCURRENCY
# PAPRIKA_S3_IO_THREADS=96
# PAPRIKA_S3_MAX_POOL_CONNECTIONS=96
