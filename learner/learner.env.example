# Copy to .env.learner (repo root) and fill in. Never commit the filled file.
LEARNER_REDIS_URL=redis://<redis-host>:6379/0
LEARNER_MARIADB_HOST=<mariadb-host>
LEARNER_MARIADB_PORT=3306
LEARNER_MARIADB_USER=<user>
LEARNER_MARIADB_PASSWORD=<password>
LEARNER_MARIADB_DATABASE=<database>
# Verifier: a playable video shorter than this is a preview, not the goal.
LEARNER_MIN_VIDEO_S=60

# --- Autopilot (off by default) ------------------------------------------
# 1 = run the playbook life cycle and publish applicable playbooks for the
# hubs (they apply them only while Settings learn_playbooks_enabled is on).
LEARNER_AUTOPILOT=0
# 1 = also let the Solver look for new playbooks (needs LEARNER_HUB_URL).
LEARNER_SOLVER_ENABLED=0
LEARNER_HUB_URL=http://<hub-host>:8000
# Leave the three LLM values empty to use whatever engine the hub's registry
# resolves for LEARNER_LLM_KIND (thermal failover included).
LEARNER_LLM_ENDPOINT=
LEARNER_LLM_MODEL=
LEARNER_LLM_API_KEY=
LEARNER_LLM_KIND=vision-chat
# Reasoning models (Qwen3 etc.): 0 = no thinking (fast), 1 = thinking,
# empty = the engine's default. LEARNER_LLM_MAX_TOKENS caps one reply,
# thinking included.
LEARNER_LLM_THINKING=
LEARNER_LLM_MAX_TOKENS=1500
# Which failures the Solver works on (Verifier reasons, comma separated).
# overlay_wall = a full-screen layer over a page whose video is wanted.
LEARNER_TARGET_REASONS=overlay_wall
# Budget: Solver runs and model tokens per UTC day.
LEARNER_SOLVER_DAILY_RUNS=40
LEARNER_SOLVER_DAILY_TOKENS=2000000
